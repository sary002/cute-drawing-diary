{
  "schema_version": 1,
  "workflow_version": "0.5",
  "workflow_mode": "learning_first",
  "photo_policy": "optional_batch_finished_only",
  "publication_policy": "on_request",
  "required_practice_fields": [
    "completion_confirmation"
  ],
  "reflection_policy": "optional_when_helpful",
  "series_title": "每天画点可爱的",
  "daily_minutes": 20,
  "current_tools": "touchmark-student-36-v2",
  "numbering": "作品编号，不要求连续自然日",
  "remote_repository": "https://github.com/sary002/cute-drawing-diary",
  "git_sync": {
    "visibility": "public",
    "trigger": "after_assistant_project_updates",
    "status": "enabled",
    "scope": "this_drawing_project_only"
  },
  "license_status": "MIT-code_CC-BY-4.0-original-content",
  "lesson_format": {
    "layout": "one_complete_markdown_per_lesson",
    "directory": "lessons/{stage}",
    "beginner_guide": "lessons/beginner/README.md",
    "target_finished_drawings": 1,
    "foundation_points": 1,
    "foundation_minutes": 3,
    "drawing_minutes": 15,
    "check_minutes": 2,
    "foundation_practice_surface": "废纸，可按实际情况省略",
    "catalog": "lessons/README.md",
    "step_count": "adaptive",
    "time_policy": "按具体教案估计，可分次；daily_minutes仅为单次练习预算，不限制整幅作品"
  },
  "learning_references": "docs/learning-references.md",
  "style_catalog": "config/styles.json",
  "default_style_id": "S001",
  "learning_rules": "docs/learning-system.md",
  "learning_progress": "config/learning-progress.json"
}
